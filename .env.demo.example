# Copy to .env.demo on the Oracle VM and replace every placeholder.
POSTGRES_USER=texa
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=texa

# Keep this secret on the VM. It is used only for organizer/admin endpoints.
TEXA_ADMIN_TOKEN=replace-with-at-least-24-random-characters

# Inwave gateway; never commit the real key.
OPENAI_API_KEY=replace-with-gateway-key
TEXA_BASE_URL=https://llmproxy.inwave.vn/v1
TEXA_DEFAULT_MODEL=gpt-6-luna
TEXA_LLM_MAX_INFLIGHT=4
TEXA_LLM_MAX_WAITERS=16
TEXA_LLM_QUEUE_TIMEOUT_S=30

# Use the public origin if the frontend is served behind a separate domain.
TEXA_CORS_ORIGINS=https://texa.example.com
