        "compiled_sql": "SELECT coalesce(sum(\"e\".\"revenue\") FILTER (WHERE (e.event_name = ANY('{purchase,order_purchased}'))), 0) AS \"revenue\" FROM analytics.event_activity e JOIN analytics.source_registry sr ON sr.source_id = e.source_id WHERE e.source_id = ANY('{cosmetics_shop}') AND (\"e\".\"ep\" -> 'device' ->> 'type') = 'mobile' AND (\"e\".\"ep\" -> 'campaign' ->> 'channel') = 'paid' LIMIT 1001",
