# Fernet key that encrypts the LLM API key stored in app.model_connection.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TEXA_SECRET_KEY=
# Optional: seed a model key instead of entering it in the UI (first one set wins; the UI overrides it).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: organisation gateway URL for the key above (LiteLLM, OpenRouter, Azure, internal proxy...).
TEXA_BASE_URL=
TEXA_DEFAULT_MODEL=
# Shared class demo: private browser histories and organizer-only model settings.
# Set ADMIN_TOKEN to a random string of at least 24 characters before enabling.
TEXA_SHARED_DEMO=0
TEXA_ADMIN_TOKEN=
# Enable only when the website is served over HTTPS (0 for localhost HTTP).
TEXA_COOKIE_SECURE=0
# Bounded per-process model admission (replace with shared semaphore if scaling workers).
TEXA_LLM_MAX_INFLIGHT=4
TEXA_LLM_MAX_WAITERS=16
TEXA_LLM_QUEUE_TIMEOUT_S=30
# Bounded end-to-end runs for the single-worker demo.
TEXA_RUN_MAX_INFLIGHT=4
TEXA_RUN_MAX_WAITERS=16
TEXA_RUN_QUEUE_TIMEOUT_S=30
# Optional shared local gateway guard. Point only to an owner-only file under .runtime;
# never put the API key itself in environment variables.
TEXA_GATEWAY_BUDGET_CREDENTIALS=
# Months of the cosmetics dataset to load (2019-Oct .. 2020-Feb).
REES46_MONTHS=2019-Dec,2020-Jan
